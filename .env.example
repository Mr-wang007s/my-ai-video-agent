# === 火山方舟 API (Seedance 2.0 视频生成 + Seedream 5.0 图像生成) ===
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-pro-250224
SEEDREAM_MODEL=doubao-seedream-5-0-260128

# === TTS API (火山引擎语音合成 - 仅用于 TTS Override) ===
VOLC_TTS_APP_ID=your_tts_app_id_here
VOLC_TTS_TOKEN=your_tts_token_here

# === OpenAI (DALL-E 图像生成) ===
OPENAI_API_KEY=your_openai_api_key_here

# === Stable Diffusion API (可选，本地图像生成) ===
SD_API_URL=http://127.0.0.1:7860
SD_API_KEY=

# === Azure TTS (可选备用) ===
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=eastasia

# === 项目配置 ===
PROJECT_ROOT=d:/codespace/my-ai-video-agent
DEFAULT_OUTPUT_DIR=assets/outputs
