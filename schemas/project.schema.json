{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MangaProject",
  "description": "AI 漫剧项目数据结构",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "description": "项目唯一标识（8 位短 UUID）"
    },
    "name": {
      "type": "string",
      "description": "项目名称"
    },
    "description": {
      "type": "string",
      "description": "项目简介"
    },
    "style": {
      "type": "string",
      "enum": ["manga", "anime", "comic", "realistic", "watercolor", "pixel"],
      "default": "manga",
      "description": "画面风格"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "confirmed", "scripted", "designed", "generating", "generated", "composing", "completed"],
      "default": "draft",
      "description": "项目当前阶段"
    },
    "config": {
      "type": "object",
      "description": "项目配置",
      "properties": {
        "target_duration": { "type": "number", "description": "目标时长（秒）" },
        "resolution": { "type": "string", "default": "1080p" },
        "fps": { "type": "integer", "default": 24 },
        "language": { "type": "string", "default": "zh-CN" }
      }
    }
  },
  "examples": [
    {
      "id": "proj001",
      "name": "都市修仙记",
      "description": "一个普通上班族意外获得修仙传承的故事",
      "style": "manga",
      "status": "draft",
      "config": {
        "target_duration": 120,
        "resolution": "1080p",
        "fps": 24,
        "language": "zh-CN"
      }
    }
  ]
}
